<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net471</TargetFramework>
    <AssemblyName>ModTranslator</AssemblyName>
    <RootNamespace>ModTranslator</RootNamespace>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- 自动检测缺氧安装路径（用于解析 DLL 引用） -->
  <UsingTask TaskName="_DetectGamePath" TaskFactory="CodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <GamePath Output="true" />
    </ParameterGroup>
    <Task>
      <Reference Include="System" />
      <Using Namespace="System" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string regPath = @"HKEY_LOCAL_MACHINE\SOFTWARE\Valve\Steam\InstallPath";
        object regVal = Microsoft.Win32.Registry.GetValue(regPath, "", null);
        GamePath = regVal != null
          ? System.IO.Path.Combine(regVal.ToString(), "steamapps", "common", "OxygenNotIncluded")
          : "";
        if (string.IsNullOrEmpty(GamePath) || !System.IO.Directory.Exists(GamePath))
        {
            string[] drives = { "C", "D", "E", "F" };
            string[] subs = { "", @"Program Files", @"Program Files (x86)" };
            foreach (string d in drives)
                foreach (string s in subs)
                {
                    string p = string.IsNullOrEmpty(s)
                        ? d + @":\Steam\steamapps\common\OxygenNotIncluded"
                        : d + ":\\" + s + "\\Steam\\steamapps\\common\\OxygenNotIncluded";
                    if (System.IO.Directory.Exists(p)) { GamePath = p; break; }
                }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <_DetectGamePath>
    <Output TaskParameter="GamePath" PropertyName="GamePath" />
  </_DetectGamePath>

  <PropertyGroup>
    <ManagedPath>$(GamePath)\OxygenNotIncluded_Data\Managed</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedPath)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedPath)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedPath)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
